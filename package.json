{
  "name": "couch-crew",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src tests realtime playwright.config.ts playwright.performance.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/preview.mjs",
    "realtime": "node realtime/server.mjs",
    "test": "npm run test:unit && npm run test:realtime && npm run test:policy && npm run test:e2e",
    "test:unit": "vitest run tests/core.test.ts",
    "test:realtime": "node --test tests/realtime.test.mjs",
    "test:policy": "node --test tests/deployment.test.mjs",
    "test:e2e": "npm run test:browser && npm run test:performance",
    "test:browser": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "eslint": "10.9.1",
    "sharp-cli": "6.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
